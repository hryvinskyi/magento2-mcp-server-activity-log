    "type": "magento2-module",
    "version": "1.1.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Volodymyr Hryvinskyi",
            "email": "volodymyr@hryvinskyi.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "hryvinskyi/magento2-activity-log": "^1.3",
        "hryvinskyi/magento2-mcp-server": "^1.3",
        "magento/framework": "*",
        "magento/module-authorization": "*",
        "magento/module-backend": "*",
        "magento/module-config": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hryvinskyi\\McpServerActivityLog\\": ""
