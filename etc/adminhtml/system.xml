<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="hryvinskyi_mcp_server">
            <group id="activity_log" translate="label comment" sortOrder="90" showInDefault="1">
                <label>Activity Log</label>
                <comment>Every ability call is recorded in the activity log, in the MCP channel, with the client, the masked arguments and result, and the changes the ability made.</comment>
                <field id="retention_days" translate="label comment" type="text" sortOrder="10" showInDefault="1">
                    <label>Keep MCP Calls (days)</label>
                    <comment>0 keeps them for good.</comment>
                    <validate>validate-digits</validate>
                </field>
            </group>
        </section>
    </system>
</config>
