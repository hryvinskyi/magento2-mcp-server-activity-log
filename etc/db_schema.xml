<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="hryvinskyi_mcp_activity_call" resource="default" engine="innodb"
           comment="The MCP call of an activity, one row per activity">
        <column xsi:type="int" name="activity_id" unsigned="true" nullable="false" comment="Activity ID"/>
        <column xsi:type="bigint" name="occurred_at_ms" unsigned="true" nullable="false"
                comment="When the call started, in milliseconds"/>
        <column xsi:type="varchar" name="ability" nullable="false" length="255" comment="Ability the client asked for"/>
        <column xsi:type="varchar" name="client_name" nullable="false" length="255" comment="Client name"/>
        <column xsi:type="varchar" name="client_version" nullable="false" length="64" comment="Client version"/>
        <column xsi:type="varchar" name="transport" nullable="false" length="16" comment="http or stdio"/>
        <column xsi:type="varchar" name="source" nullable="true" length="32" comment="Ability source"/>
        <column xsi:type="varchar" name="source_reference" nullable="true" length="255" comment="Within its source"/>
        <column xsi:type="varchar" name="access" nullable="true" length="16" comment="read, write or delete"/>
        <column xsi:type="text" name="acl_resources" nullable="true" comment="ACL resources, JSON"/>
        <column xsi:type="varchar" name="outcome" nullable="false" length="32" comment="How the call ended"/>
        <column xsi:type="varchar" name="denial_reason" nullable="false" length="64" default="" comment="Why it was refused"/>
        <column xsi:type="text" name="message" nullable="true" comment="Error or refusal message"/>
        <column xsi:type="mediumtext" name="arguments" nullable="true" comment="Masked arguments, JSON"/>
        <column xsi:type="mediumtext" name="result" nullable="true" comment="Masked result, JSON"/>
        <column xsi:type="boolean" name="is_truncated" nullable="false" default="false"
                comment="Arguments or result cut to the stored size"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="activity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="HRYVINSKYI_MCP_ACTIVITY_CALL_ACTIVITY_ID"
                    table="hryvinskyi_mcp_activity_call" column="activity_id"
                    referenceTable="hryvinskyi_activity_log" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="HRYVINSKYI_MCP_ACTIVITY_CALL_OCCURRED_AT_MS" indexType="btree">
            <column name="occurred_at_ms"/>
        </index>
    </table>
</schema>
