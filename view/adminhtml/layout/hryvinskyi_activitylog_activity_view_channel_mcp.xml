<!-- The MCP call of an "mcp" activity, for an admin who may see the MCP Server page -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Hryvinskyi_McpServerActivityLog::css/mcp-panel.css"/>
    </head>
    <body>
        <referenceBlock name="activity.channel.fallback" remove="true"/>
        <referenceContainer name="activity.channel.panel">
            <block class="Magento\Framework\View\Element\Template" name="mcp.activity.call.panel"
                   template="Hryvinskyi_McpServerActivityLog::activity/mcp-panel.phtml"
                   aclResource="Hryvinskyi_McpServer::view">
                <arguments>
                    <argument name="panel" xsi:type="object">Hryvinskyi\McpServerActivityLog\ViewModel\McpCallPanel</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
