<!-- The clients of the last 24 hours, under the MCP Server page's connection card -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Hryvinskyi_McpServerActivityLog::css/mcp-panel.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="mcp.activity.recent.clients"
                   template="Hryvinskyi_McpServerActivityLog::server/clients.phtml"
                   after="hryvinskyi.mcp.server.overview" aclResource="Hryvinskyi_ActivityLog::view">
                <arguments>
                    <argument name="recent" xsi:type="object">Hryvinskyi\McpServerActivityLog\ViewModel\RecentClients</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
