declare(strict_types=1);

use Hryvinskyi\McpServerActivityLog\ViewModel\RecentClients;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/**
 * The MCP clients of the last 24 hours, on the MCP Server page
 *
 * @var Template $block
 * @var Escaper $escaper
 */
$recent = $block->getData('recent');
if (!$recent instanceof RecentClients) {
    return;
}
$clients = $recent->clients();
?>
<p class="mcp-recent-clients">
    <strong><?= $escaper->escapeHtml(__('Clients in the last 24 h:')) ?></strong>
    <?php if ($clients === []): ?>
        <?= $escaper->escapeHtml(__('none')) ?>
    <?php else: ?>
        <?php foreach ($clients as $index => $client): ?>
            <?= $index > 0 ? ' · ' : '' ?><?= $escaper->escapeHtml(trim($client['name'] . ' ' . $client['version'])) ?>
            (<?= $escaper->escapeHtml(__('%1 calls', $client['calls'])) ?>)
        <?php endforeach; ?>
    <?php endif; ?>
    <a href="<?= $escaper->escapeUrl($recent->activityUrl()) ?>"><?= $escaper->escapeHtml(__('MCP activity')) ?></a>
</p>
